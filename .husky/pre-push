# Pre-push checks (same logic as the x repo): formatting, then lint + typecheck + build/tests.

echo "💅 Checking formatting..."
if ! npm run format:check > /dev/null 2>&1; then
  npm run format > /dev/null 2>&1
  echo ""
  echo "⚠️  Prettier reformatted some files. Please commit the changes and push again:"
  echo ""
  git diff --name-only
  echo ""
  exit 1
fi

echo "🔍 Running validate (lint + typecheck + build)..."
if ! npm run validate; then
  echo ""
  echo "❌ Validation failed. Fix the errors above before pushing."
  echo ""
  exit 1
fi

echo ""
echo "✅ All checks passed!"
