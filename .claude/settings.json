{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "WebSearch",
      "WebFetch",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(yarn *)",
      "Bash(corepack *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(vercel *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(jq *)",
      "Bash(curl *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(rm *)",
      "Bash(touch *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed *)",
      "mcp__claude_ai_Spotify__search",
      "mcp__claude_ai_Spotify__create_playlist"
    ],
    "deny": [
      "Read(./.next/**)",
      "Read(./**/*.tsbuildinfo)",
      "Read(./package-lock.json)",
      "Read(./pnpm-lock.yaml)",
      "Read(./yarn.lock)",
      "Read(./build/**)",
      "Read(./dist/**)",
      "Read(./coverage/**)",
      "Read(./.turbo/**)"
    ]
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true
  }
}
